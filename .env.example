# ── Supabase (база данных) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# ── OpenAI (разрешение названий компаний и обогащение контактов) ──
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# ── Hunter.io (поиск контактов) ──
HUNTER_API_KEY=your_hunter_api_key

# ── Yandex Search API (этап новостей) ──
YANDEX_SEARCH_API_KEY=your_yandex_search_api_key
# ВАЖНО: сюда нужен folderId каталога Yandex Cloud, а НЕ идентификатор API-ключа.
YANDEX_SEARCH_API_KEY_ID=your_yandex_folder_id
# Понятный псевдоним для folderId; если задан — имеет приоритет над строкой выше.
YANDEX_FOLDER_ID=your_yandex_folder_id

# ── Playwright (парсинг страниц на этапе новостей) ──
# Прокси: строка через запятую ИЛИ JSON-массив. Пусто = прямое соединение.
# Примеры:
#   PLAYWRIGHT_PROXIES=http://user:pass@host:port,socks5://user:pass@host:port
#   PLAYWRIGHT_PROXIES=["http://host:3128","socks5://user:pass@host:1080"]
PLAYWRIGHT_PROXIES=
PLAYWRIGHT_TIMEOUT_MS=20000
PLAYWRIGHT_CONCURRENCY=4
